#!/bin/sh

if [ -z "${ENGINE_HTTP_PORT+x}" ]; then
  echo "ENGINE_HTTP_PORT is unset, using default 80"
  export ENGINE_HTTP_PORT=80
fi

if [ -z "${ENGINE_HTTPS_PORT+x}" ]; then
  echo "ENGINE_HTTPS_PORT is unset, using default 443"
  export ENGINE_HTTPS_PORT=443
fi

# An empty limit_req_zone key means nginx never rate-limits the request, so
# this lets the nginx config templates express DISABLE_REQUEST_LIMIT without
# needing to mutate the rendered config file at boot (which would require a
# writable filesystem).
if [ "$DISABLE_REQUEST_LIMIT" = "true" ]; then
  echo "DISABLE_REQUEST_LIMIT is set to true, disabling request limiting"
  export LIMIT_REQ_KEY='""'
else
  export LIMIT_REQ_KEY='$binary_remote_addr'
fi

if [ -z "${BASE_URL+x}" ]; then
  echo "BASE_URL is unset, using default /"
  export BASE_URL=/
fi
case "$BASE_URL" in
  */) ;;
  *) export BASE_URL="$BASE_URL/" ;;
esac

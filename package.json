{
  "name": "gams-engine-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage --coverage.exclude=__tests__/** --coverage.exclude=assets/**",
    "test:ci": "vitest --run --coverage --reporter=default --reporter=junit --outputFile=junit.xml --coverage.exclude=__tests__/** --coverage.exclude=assets/**",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "deno run -A eslint-wrapper.ts --max-warnings 0 ./src"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "memoize": "^11.0.0",
    "moment": "^2.31.0",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-router": "^8.3.0",
    "react-select": "^5.10.2",
    "react-spinners": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "canvas": "^3.2.3",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-select-event": "^5.5.1",
    "sass": "^1.102.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
